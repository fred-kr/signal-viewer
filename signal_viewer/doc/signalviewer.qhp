<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifest of the bundled user guide. `signal_viewer.sv_help.read_manifest` reads the table of contents and the
  keyword index from it; nothing compiles it into a .qch any more. `ref` values are paths relative to this folder,
  optionally with #anchor. `tests/test_help.py` checks that every ref exists.
-->
<QtHelpProject version="1.0">
    <namespace>com.quacktech.signalviewer</namespace>
    <virtualFolder>signalviewer</virtualFolder>
    <filterSection>
        <toc>
            <section title="SignalViewer User Guide" ref="index.html">
                <section title="Getting started" ref="user_guide/getting_started.html">
                    <section title="Open a file" ref="user_guide/getting_started.html#open"/>
                    <section title="Sampling rate" ref="user_guide/getting_started.html#sampling-rate"/>
                    <section title="Signal and info channel" ref="user_guide/getting_started.html#channels"/>
                    <section title="Load the data" ref="user_guide/getting_started.html#load"/>
                </section>
                <section title="Working with sections" ref="user_guide/sections.html">
                    <section title="Create a section" ref="user_guide/sections.html#create"/>
                    <section title="Switch sections" ref="user_guide/sections.html#activate"/>
                    <section title="Lock and unlock" ref="user_guide/sections.html#lock"/>
                    <section title="Channels" ref="user_guide/sections.html#channels"/>
                </section>
                <section title="Preprocessing the signal" ref="user_guide/preprocessing.html">
                    <section title="Pipelines" ref="user_guide/preprocessing.html#pipeline"/>
                    <section title="Custom filter" ref="user_guide/preprocessing.html#filter"/>
                    <section title="Standardization" ref="user_guide/preprocessing.html#standardization"/>
                </section>
                <section title="Detecting and editing peaks" ref="user_guide/peak_detection.html">
                    <section title="Detection methods" ref="user_guide/peak_detection.html#methods"/>
                    <section title="Navigate the plot" ref="user_guide/peak_detection.html#navigate"/>
                    <section title="Edit peaks by hand" ref="user_guide/peak_detection.html#edit"/>
                </section>
                <section title="Results and export" ref="user_guide/results.html">
                    <section title="Rate calculation" ref="user_guide/results.html#rate"/>
                    <section title="Result tables" ref="user_guide/results.html#tables"/>
                    <section title="Result plot" ref="user_guide/results.html#plot"/>
                    <section title="Export to Excel" ref="user_guide/results.html#export"/>
                </section>
            </section>
            <section title="Reference" ref="reference/main_window.html">
                <section title="Main window, menus and shortcuts" ref="reference/main_window.html"/>
                <section title="Import page" ref="reference/page_import.html"/>
                <section title="Graph page" ref="reference/page_graph.html"/>
                <section title="Results page" ref="reference/page_results.html"/>
                <section title="Parameter Inputs dock" ref="reference/dock_parameters.html"/>
                <section title="Sections dock" ref="reference/dock_sections.html"/>
                <section title="Status Log dock" ref="reference/dock_log.html"/>
                <section title="File Metadata dialog" ref="reference/dialog_metadata.html"/>
                <section title="Settings" ref="reference/settings.html"/>
                <section title="File formats" ref="reference/file_formats.html"/>
                <section title="Command line flags" ref="reference/command_line.html"/>
            </section>
        </toc>
        <keywords>
            <keyword name="Open file" ref="user_guide/getting_started.html#open"/>
            <keyword name="Recent files" ref="user_guide/getting_started.html#open"/>
            <keyword name="Sampling rate" ref="user_guide/getting_started.html#sampling-rate"/>
            <keyword name="Signal channel" ref="user_guide/getting_started.html#channels"/>
            <keyword name="Info channel" ref="user_guide/getting_started.html#channels"/>
            <keyword name="Temperature" ref="user_guide/getting_started.html#channels"/>
            <keyword name="Load data" ref="user_guide/getting_started.html#load"/>

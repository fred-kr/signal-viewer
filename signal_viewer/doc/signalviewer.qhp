            <keyword name="Click radius" ref="reference/settings.html"/>
            <keyword name="Float precision" ref="reference/settings.html"/>
            <keyword name="Text file separator" ref="reference/settings.html"/>
            <keyword name="Rate computation method" ref="reference/settings.html"/>
            <keyword name="Command line" ref="reference/command_line.html"/>
            <keyword name="Debug log" ref="reference/command_line.html"/>
            <keyword name="Reset settings" ref="reference/command_line.html"/>
            <keyword name="OpenGL" ref="reference/command_line.html"/>
        </keywords>
        <files>
            <file>*.html</file>
            <file>*.css</file>
            <file>user_guide/*.html</file>
            <file>reference/*.html</file>
            <file>images/*.png</file>
        </files>
    </filterSection>
</QtHelpProject>

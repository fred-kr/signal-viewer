            <keyword name="Copy to clipboard" ref="user_guide/results.html#tables"/>
            <keyword name="Keyboard shortcuts" ref="reference/main_window.html#shortcuts"/>
            <keyword name="Menus" ref="reference/main_window.html#menus"/>
            <keyword name="Toolbars" ref="reference/main_window.html#toolbars"/>
            <keyword name="What's This" ref="reference/main_window.html#help"/>

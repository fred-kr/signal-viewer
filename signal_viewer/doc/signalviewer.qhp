            <keyword name="Manual edits" ref="user_guide/peak_detection.html#edit"/>
            <keyword name="Rate" ref="user_guide/results.html#rate"/>
            <keyword name="Rolling window" ref="user_guide/results.html#rate"/>
            <keyword name="Instantaneous rate" ref="user_guide/results.html#rate"/>
            <keyword name="Incomplete window" ref="user_guide/results.html#rate"/>
            <keyword name="Result tables" ref="user_guide/results.html#tables"/>
            <keyword name="Result plot" ref="user_guide/results.html#plot"/>
            <keyword name="Fit model" ref="user_guide/results.html#plot"/>
            <keyword name="GAM" ref="user_guide/results.html#plot"/>

            <keyword name="Add peak" ref="user_guide/peak_detection.html#edit"/>
            <keyword name="Remove peak" ref="user_guide/peak_detection.html#edit"/>
            <keyword name="Selection" ref="user_guide/peak_detection.html#edit"/>
            <keyword name="Find peaks in selection" ref="user_guide/peak_detection.html#edit"/>

   <item row="0" column="0" colspan="3" alignment="Qt::AlignmentFlag::AlignTop">
    <widget class="QTabWidget" name="container_tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab_required_metadata">
      <attribute name="title">
       <string>Required Metadata</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item>
        <widget class="QWidget" name="container_form_layout" native="true">
         <layout class="QFormLayout" name="formLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="label_2">
            <property name="text">
             <string>File Name</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="line_edit_file_name">
            <property name="toolTip">
             <string>Name of the open file</string>
            </property>
            <property name="readOnly">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_4">
            <property name="text">
             <string>File Type</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="line_edit_file_type">
            <property name="toolTip">
             <string>File extension; it selects the reader</string>
            </property>
            <property name="readOnly">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_3">
            <property name="whatsThis">
             <string>&lt;p&gt;Number of samples recorded per second (Hz). It converts sample indices into time and every filter and detector depends on it.&lt;/p&gt;&lt;p&gt;Filled in automatically when the file has a time column or, for EDF, from the header; otherwise enter it here.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#sampling-rate&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>Samples per second of the signal (Hz); required</string>
            </property>
            <property name="text">
             <string>Sampling Rate*</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="spin_box_sampling_rate">
            <property name="whatsThis">
             <string>&lt;p&gt;Number of samples recorded per second (Hz). It converts sample indices into time and every filter and detector depends on it.&lt;/p&gt;&lt;p&gt;Filled in automatically when the file has a time column or, for EDF, from the header; otherwise enter it here.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#sampling-rate&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>Samples per second of the signal (Hz); required</string>
            </property>
            <property name="styleSheet">
             <string notr="true"/>
            </property>
            <property name="specialValueText">
             <string>&lt;Not set&gt;</string>
            </property>
            <property name="suffix">
             <string> Hz</string>
            </property>
            <property name="maximum">
             <number>10000</number>
            </property>
            <property name="mandatoryField" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_5">
            <property name="whatsThis">
             <string>&lt;p&gt;The column (channel) whose values are the signal. Only numeric columns are offered. This channel is loaded first; every other numeric column can be edited later through the channel switcher on the Graph page.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#channels&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>The column (channel) of the file holding the signal to analyse</string>
            </property>
            <property name="text">
             <string>Signal Channel*</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="label_6">
            <property name="whatsThis">
             <string>&lt;p&gt;An optional column recorded alongside the signal, such as temperature or oxygen saturation. The rate table gets its mean, standard deviation, minimum and maximum per rate window, and the result plot shows the rate against it.&lt;/p&gt;&lt;p&gt;Choose &amp;lt;No Selection&amp;gt; when there is none.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#channels&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>Optional second column (e.g. temperature) shown with the signal and summarised per rate window</string>
            </property>
            <property name="text">
             <string>Info Channel</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QComboBox" name="combo_box_signal_column">
            <property name="whatsThis">
             <string>&lt;p&gt;The column (channel) whose values are the signal. Only numeric columns are offered. This channel is loaded first; every other numeric column can be edited later through the channel switcher on the Graph page.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#channels&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>The column (channel) of the file holding the signal to analyse</string>
            </property>
            <property name="mandatoryField" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QComboBox" name="combo_box_info_column">
            <property name="whatsThis">
             <string>&lt;p&gt;An optional column recorded alongside the signal, such as temperature or oxygen saturation. The rate table gets its mean, standard deviation, minimum and maximum per rate window, and the result plot shows the rate against it.&lt;/p&gt;&lt;p&gt;Choose &amp;lt;No Selection&amp;gt; when there is none.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#channels&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>Optional second column (e.g. temperature) shown with the signal and summarised per rate window</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>

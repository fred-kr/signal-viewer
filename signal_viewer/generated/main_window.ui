   <widget class="QMenu" name="menu_plot">
    <property name="title">
     <string>Plot</string>
    </property>
    <property name="toolTipsVisible">
     <bool>true</bool>
    </property>
    <addaction name="action_remove_peaks_in_selection"/>
    <addaction name="action_find_peaks_in_selection"/>
    <addaction name="action_toggle_auto_scaling"/>
   </widget>
   <widget class="QMenu" name="menu_help">
    <property name="title">
     <string>Help</string>
    </property>
    <addaction name="separator"/>
    <addaction name="action_about_app"/>
    <addaction name="action_about_qt"/>
   </widget>
   <addaction name="menu_file"/>
   <addaction name="menu_view"/>
   <addaction name="menu_plot"/>
   <addaction name="menu_settings"/>
   <addaction name="menu_help"/>
  </widget>
  <widget class="QStatusBar" name="status_bar"/>
  <action name="action_open_file">
   <property name="icon">
    <iconset theme="QIcon::ThemeIcon::DocumentOpen"/>
   </property>
   <property name="text">
    <string>Open File...</string>
   </property>
   <property name="iconText">
    <string>Open File...</string>
   </property>
   <property name="toolTip">
    <string>Select a file to open</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Opens a file dialog. The chosen file is scanned for its columns (channels) and, where possible, its sampling rate; nothing is loaded yet. Numeric columns appear in the Signal Channel and Info Channel lists.&lt;/p&gt;&lt;p&gt;Supported formats: CSV, TXT, TSV, XLS, XLSX, Feather/Arrow and EDF.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::TextHeuristicRole</enum>
   </property>
   <property name="iconVisibleInMenu">
    <bool>true</bool>
   </property>
  </action>
  <action name="action_show_settings">
   <property name="icon">
    <iconset resource="../resources.qrc">
     <normaloff>:/icons/Settings.svg</normaloff>:/icons/Settings.svg</iconset>
   </property>
   <property name="text">
    <string>Preferences</string>
   </property>
   <property name="toolTip">
    <string>Open the Settings dialog (Ctrl+,)</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Plot click tolerances, filter stacking, the rate computation method, table precision and the text file separator. Changes apply when you press OK.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:reference/settings.html&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+,</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::PreferencesRole</enum>
   </property>
  </action>
  <action name="action_edit_metadata">
   <property name="enabled">
    <bool>false</bool>
   </property>
   <property name="text">
    <string>File Metadata</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Open a more detailed view of the current file's metadata.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Shows a dialog with fields for the sampling rate, the signal channel and the info channel of the open file. The same values are editable on the Import page; they are fixed once the data is loaded.&lt;/p&gt;&lt;p&gt;The second tab shows metadata stored in the file itself, for EDF files the header information read by the mne library.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:reference/dialog_metadata.html&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="iconVisibleInMenu">
    <bool>false</bool>
   </property>
  </action>
  <action name="action_close_file">
   <property name="enabled">
    <bool>false</bool>
   </property>
   <property name="text">
    <string>Close File</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Close the current file and reset the app state.&lt;/p&gt;&lt;p&gt;Make sure to export any existing results first, as they will be lost on reset.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Closes the open file and resets the application. Export your results first; sections and results of every channel are discarded.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
   <property name="iconVisibleInMenu">
    <bool>false</bool>
   </property>
  </action>
  <action name="action_mark_section_done">
   <property name="icon">
    <iconset>
     <normaloff>://icons/CheckmarkCircle.svg</normaloff>://icons/CheckmarkCircle.svg</iconset>
   </property>
   <property name="text">
    <string>Lock Section</string>
   </property>
   <property name="toolTip">
    <string>Compute the result of the active section and lock it against edits</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Computes the final peak and rate tables of the active section in the background and locks it so that processing and peaks cannot change any more. Only locked sections appear on the Results page and in the export.&lt;/p&gt;&lt;p&gt;At least three peaks are needed. To edit a locked section again use Unlock Section.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#lock&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_create_new_section">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="icon">
    <iconset>
     <normaloff>://icons/AddCircle.svg</normaloff>://icons/AddCircle.svg</iconset>
   </property>
   <property name="text">
    <string>New Section</string>
   </property>
   <property name="toolTip">
    <string>Select a range of the base section to turn into a new section</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Available while the base section (Section 000) is active. Shows a draggable region on the plot: move its edges to the wanted range, then press Confirm in the Sections dock, or Cancel.&lt;/p&gt;&lt;p&gt;The region starts right after the previous section with the same length.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#create&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_toggle_auto_scaling">
   <property name="icon">
    <iconset>
     <normaloff>://icons/AutoFitHeight.svg</normaloff>://icons/AutoFitHeight.svg</iconset>
   </property>
   <property name="text">
    <string>Scale y-axis</string>
   </property>
   <property name="toolTip">
    <string>Automatically scale the y-axis to fit the currently visible data</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Rescales the signal plot so that the whole signal is visible after zooming or panning.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/peak_detection.html#navigate&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_confirm_section">
   <property name="icon">
    <iconset>
     <normaloff>://icons/Checkmark.svg</normaloff>://icons/Checkmark.svg</iconset>
   </property>
   <property name="text">
    <string>Confirm Section</string>
   </property>
   <property name="toolTip">
    <string>Create a new section with the data of the selected region</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Creates the new section from the selected region and adds it to the Sections list.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#create&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_cancel_section">
   <property name="icon">
    <iconset>
     <normaloff>://icons/Dismiss.svg</normaloff>://icons/Dismiss.svg</iconset>
   </property>
   <property name="text">
    <string>Cancel Section</string>
   </property>
   <property name="toolTip">
    <string>Cancel the section creation process</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Hides the region selector without creating a section.&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_show_section_overview">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>false</bool>
   </property>
   <property name="text">
    <string>Section Overview</string>
   </property>
   <property name="toolTip">
    <string>Shows the current sections as colored regions in the plot</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Shows every section of the active channel as a coloured region on the plot of the base section. Click a region to make that section active; hover it for its name.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#overview&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_remove_peaks_in_selection">
   <property name="text">
    <string>Remove Peaks in Selection</string>
   </property>
   <property name="toolTip">
    <string>Select an area of the plot by pressing Ctrl and dragging your mouse while holding left-click. Then, press Ctrl+D to remove all peaks inside that area.</string>
   </property>
   <property name="whatsThis">
    <string>Select an area of the plot by pressing Ctrl and dragging your mouse while holding left-click. Then, press Ctrl+D to remove all peaks inside that area.</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+D</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::ApplicationSpecificRole</enum>
   </property>
  </action>
  <action name="action_find_peaks_in_selection">
   <property name="text">
    <string>Find Peaks in Selection</string>
   </property>
   <property name="toolTip">
    <string>Select an area of the plot by pressing Ctrl and dragging your mouse while holding left-click. Then, press Ctrl+F to search that area for peaks.</string>
   </property>
   <property name="whatsThis">
    <string>Select an area of the plot by pressing Ctrl and dragging your mouse while holding left-click. Then, press Ctrl+F to search that area for peaks.</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+F</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::ApplicationSpecificRole</enum>
   </property>
  </action>
  <action name="action_show_user_guide">
   <property name="icon">
    <iconset>
     <normaloff>://icons/BookQuestionMark.svg</normaloff>://icons/BookQuestionMark.svg</iconset>
   </property>
   <property name="text">
    <string>User Guide</string>
   </property>
   <property name="toolTip">
    <string>Open the user guide at the page for the current view (F1)</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Opens the bundled user guide. Press F1 anywhere: the page matching the current page (or the parameter dock, when it has focus) opens.&lt;/p&gt;&lt;p&gt;Shift+F1 enters What's This mode: click any control to read what it does.&lt;/p&gt;</string>
   </property>
   <property name="shortcut">
    <string>F1</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_about_qt">
   <property name="text">
    <string>About Qt</string>
   </property>
   <property name="toolTip">
    <string>Version of the Qt libraries this application runs on</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::AboutQtRole</enum>
   </property>
  </action>
  <action name="action_about_app">
   <property name="text">
    <string>About App</string>
   </property>
   <property name="toolTip">
    <string>Version and links of this application</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::AboutRole</enum>
   </property>
  </action>
  <action name="action_remove_section">
   <property name="icon">
    <iconset>
     <normaloff>://icons/SubtractCircle.svg</normaloff>://icons/SubtractCircle.svg</iconset>
   </property>
   <property name="text">
    <string>Remove Section</string>
   </property>
   <property name="toolTip">
    <string>Delete the active section and its results</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Deletes the active section together with its peaks and results. Cannot be undone. The base section cannot be removed; sections after the deleted one are renumbered.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#remove&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
  <action name="action_unlock_section">
   <property name="icon">
    <iconset>
     <normaloff>://icons/LockOpen.svg</normaloff>://icons/LockOpen.svg</iconset>
   </property>
   <property name="text">
    <string>Unlock Section</string>
   </property>
   <property name="toolTip">
    <string>Make the locked active section editable again</string>
   </property>
   <property name="whatsThis">
    <string>&lt;p&gt;Removes the lock from the active section so that processing and peaks can be changed. The previous result stays until the next change; the Results page and the export only reflect locked sections.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/sections.html#lock&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
   </property>
   <property name="menuRole">
    <enum>QAction::MenuRole::NoRole</enum>
   </property>
  </action>
 </widget>
 <customwidgets>
  <customwidget>
   <class>MatplotlibWidget</class>
   <extends>QWidget</extends>
   <header>pyqtgraph.widgets.MatplotlibWidget</header>
   <container>1</container>
  </customwidget>
 </customwidgets>

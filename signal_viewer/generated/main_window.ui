                </property>
                <property name="suffix">
                 <string> Hz</string>
                </property>
                <property name="maximum">
                 <number>10000</number>
                </property>
                <property name="value">
                 <number>0</number>
                </property>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QLabel" name="signalColumnChannelLabel">
                <property name="toolTip">
                 <string>The column (channel) of the file holding the signal to analyse</string>
                </property>
                <property name="whatsThis">
                 <string>&lt;p&gt;The column (channel) whose values are the signal. Only numeric columns are offered. This channel is loaded first; every other numeric column can be edited later through the channel switcher on the Graph page.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/getting_started.html#channels&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
                </property>
                <property name="text">
                 <string>Signal Channel</string>
                </property>
                <property name="alignment">

          </property>
          <property name="whatsThis">
           <string>&lt;p&gt;Writes the results of all sections of every loaded channel to one workbook, or to one workbook per channel. Sheets: r_data (rate per window with the info mean), Detected Peaks, Rate Data, Global Bounds.&lt;/p&gt;&lt;p&gt;Only locked sections have results; you are warned about unlocked ones.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;help:user_guide/results.html#export&quot;&gt;Open the user guide&lt;/a&gt;&lt;/p&gt;</string>
          </property>
